  },
  "resources": {
    "categoriesPath": "Categories.xml",
    "baseFilesPath": "fallout4vr_base.txt"
  },
  "theme": {
    "primaryColor": "#32689E"
  },
  "setup": {
    "useGenericSetup": true
  },
  "settings": {
    "useGenericSettings": true
  },
  "modInstall": {
    "pathAdjustmentProfile": "none",
    "supportsGameRootInstall": true,
    "hardlinkRequiredExtensions": [
      ".esp",
      ".esl",
      ".esm",
      ".ba2",
      ".bsa",
      ".mp3",
      ".bgsm",
      ".bgem",
      ".wav",
      ".ogg",
      ".xwm"
    ],
    "realFileRequiredExtensions": [
      ".dll",
      ".exe"
    ]
  },
  "compatibilityNotes": [
    "Ported from the C# Fallout4VR game mode (#24)."
  ],
  "pluginExtensions": [
    ".esm",
    ".esl",
    ".esp"
  ],
  "orderedCriticalPluginNames": [
    "Fallout4.esm",
    "Fallout4_VR.esm"
  ],
  "plugin": {
    "usesPlugins": true,
    "pluginDirectorySuffix": "Data",
    "supportsPluginAutoSorting": false,
    "maxAllowedActivePluginsCount": 255,
    "policy": {
      "schemaVersion": 1,
      "persistenceStrategy": "singleFile",
      "pluginsFilePath": "{LocalApplicationData}\\Fallout4VR\\plugins.txt",
      "loadOrderFilePath": "{LocalApplicationData}\\Fallout4VR\\plugins.txt",
      "activeMarker": "*",
      "appDataGameFolderName": "Fallout4VR",
      "useTimestampOrder": false,
      "ignoreOfficialPlugins": true,
      "forcedReadOnly": false,
      "singleFileManagement": true,
      "officialPluginsAreImplicitlyActive": true
    }
  },
  "gamebryo": {
    "scriptExtenderExecutables": [
      "f4se_loader.exe"
    ],
    "userGameDataPath": "{PersonalData}\\My Games\\Fallout4VR",
    "iniFilePath": "{UserGameData}\\Fallout4Custom.ini",
    "pluginsFilePath": "{LocalApplicationData}\\Fallout4VR\\plugins.txt",
    "additionalSettingsFiles": {
      "FOPrefsIniPath": "{UserGameData}\\Fallout4Prefs.ini"
    }
  }
