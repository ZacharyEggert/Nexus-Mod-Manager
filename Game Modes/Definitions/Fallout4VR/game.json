{
  "schemaVersion": 2,
  "modeId": "Fallout4VR",
  "name": "Fallout 4 VR",
  "behaviorProfile": "gamebryo",
  "legacyFallback": false,
  "gameExecutables": [
    "Fallout4VR.exe"
  ],
  "stopFolders": [
    "textures",
    "scripts",
    "meshes",
    "music",
    "shaders",
    "video",
    "interface",
    "facegen",
    "menus",
    "lodsettings",
    "lsdata",
    "sound",
    "CalienteTools",
    "SKSE",
    "MWSE",
    "NVSE",
    "F4SE",
    "FOSE",
    "OBSE",
    "F4SE"
  ],
  "supportedFormats": [
    "fomod"
  ],
  "discovery": {
    "stores": [
      {
        "store": "Steam",
        "id": "611660",
        "installFolderName": "Fallout4VR",
        "executableName": "Fallout4VR.exe"
      }
    ]
  },
  "launcher": {
    "defaultExecutable": "Fallout4VR.exe",
    "plainCommandName": "PlainLaunch",
    "plainCommandText": "Launch Fallout 4 VR",
    "customCommandName": "CustomLaunch",
    "customCommandText": "Launch Custom Fallout 4 VR",
    "defaultCommandText": "Launch Fallout 4 VR",
